{
  "name": "railwayfront-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:worker": "nuxt build --preset cloudflare",
    "build:pages": "nuxt build --preset cloudflare-pages",
    "dev": "nuxt dev --dotenv .env.dev",
    "generate": "nuxt generate --dotenv .env.client",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "wrangler pages deploy dist --project-name railwayfront",
    "deploy:pages": "wrangler pages deploy dist --project-name railwayfront"
  },
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@nuxtjs/i18n": "^9.1.5",
    "@pinia/nuxt": "^0.11.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "debounce": "^2.2.0",
    "embla-carousel-vue": "^8.5.2",
    "moment-timezone": "^0.5.47",
    "nuxt": "^3.21.7",
    "pinia": "^3.0.4",
    "vue": "latest",
    "vue-cryptojs": "^2.4.8",
    "vue-dompurify-html": "^5.3.0",
    "vue-router": "latest",
    "vue3-social-sharing": "^1.5.0"
  },
  "devDependencies": {
    "stylus": "^0.64.0",
    "wrangler": "^4.0.0"
  }
}
